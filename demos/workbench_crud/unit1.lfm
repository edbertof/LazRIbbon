  object BackstageView: TLazRibbonBackstageView
    Left = 0
    Height = 546
    Top = 112
    Width = 1120
    Align = alClient
    OverlayMode = bomCoverClientArea
    ActivePageIndex = 0
    BackstageTabCaption = 'Arquivo'
    BackButtonHint = 'Voltar'
    NavigationWidth = 190
    ItemHeight = 42
    LinkedToolbar = LazRibbon1
    SkinManager = LazRibbonSkinManager1
    Visible = False
    Buttons = <
      item
        Caption = 'Informacoes'
        Page = BackstagePageInfo
      end
      item
        Caption = 'Bases recentes'
        Page = BackstagePageRecent
      end
      item
        Caption = 'Opcoes'
        Page = BackstagePageOptions
        BeginGroup = True
      end
      item
        Kind = bbkSeparator
      end
      item
        Kind = bbkCommand
        Action = actSaveCustomer
        CloseBackstageOnClick = False
      end
      item
        Kind = bbkCommand
        Action = actExport
        CloseBackstageOnClick = False
      end
      item
        Kind = bbkCommand
        Action = actExit
        Section = bbsBottom
      end>
    object BackstagePageInfo: TLazRibbonBackstagePage
      Left = 190
      Height = 546
      Top = 0
      Width = 930
      Caption = 'Informacoes'
      object LabelBackstageInfoTitle: TLabel
        Left = 36
        Height = 30
        Top = 32
        Width = 320
        Caption = 'Workbench CRUD'
        Font.Height = -24
        Font.Name = 'Segoe UI'
        Font.Style = [fsBold]
        ParentFont = False
      end
      object LabelBackstageInfoText: TLabel
        Left = 38
        Height = 94
        Top = 82
        Width = 680
        Caption = 'Este demo mostra uma composicao de aplicacao administrativa: Ribbon no topo, BackStage cobrindo a area cliente, Quick Access Toolbar, SkinManager, galeria de skins, popup Ribbon, grade de dados e painel de edicao.'
        Font.Height = -13
        Font.Name = 'Segoe UI'
        ParentFont = False
        WordWrap = True
      end
    end
    object BackstagePageRecent: TLazRibbonBackstagePage
      Left = 190
      Height = 546
      Top = 0
      Width = 930
      Caption = 'Bases recentes'
      object RecentList: TLazRibbonBackstageRecentList
        Left = 32
        Height = 446
        Top = 36
        Width = 820
        Anchors = [akTop, akLeft, akRight, akBottom]
        AppearanceSource = asSkinManager
        ItemHeight = 54
        MaxRecentItems = 20
        ScrollBarMode = rsmAuto
        StorageSection = 'WorkbenchRecentDatabases'
        Items.Strings = (
          'Clientes 2026=sample-data\clientes'
          'Prospects regional sul=sample-data\prospects'
          'Contratos ativos=sample-data\contratos'
          'Pedidos pendentes=sample-data\pedidos'
        )
        SelectedIndex = 0
        SkinManager = LazRibbonSkinManager1
        OnItemClick = BackstageRecentClick
      end
    end
    object BackstagePageOptions: TLazRibbonBackstagePage
      Left = 190
      Height = 546
      Top = 0
      Width = 930
      Caption = 'Opcoes'
      object LabelBackstageOptionsTitle: TLabel
        Left = 36
        Height = 30
        Top = 32
        Width = 220
        Caption = 'Opcoes'
        Font.Height = -24
        Font.Name = 'Segoe UI'
        Font.Style = [fsBold]
        ParentFont = False
      end
      object LabelBackstageOptionsText: TLabel
        Left = 38
        Height = 86
        Top = 82
        Width = 680
        Caption = 'Area reservada para preferencias globais, conexao de dados, auditoria, exportacao e configuracoes de usuario. Em sistemas reais, estas paginas recebem controles LCL comuns dentro do BackStage.'
        Font.Height = -13
        Font.Name = 'Segoe UI'
        ParentFont = False
        WordWrap = True
      end
    end
  end
  object PopupGrid: TLazRibbonPopupMenu
    Left = 224
    Top = 184
    object MenuNewCustomer: TMenuItem
      Action = actNewCustomer
    end
    object MenuEditCustomer: TMenuItem
      Action = actEditCustomer
    end
    object MenuDeleteCustomer: TMenuItem
      Action = actDeleteCustomer
    end
    object MenuSeparator1: TMenuItem
      Caption = '-'
    end
    object MenuExport: TMenuItem
      Action = actExport
    end
  end
end
