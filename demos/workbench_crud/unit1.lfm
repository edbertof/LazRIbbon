object Form1: TForm1
  Left = 220
  Height = 680
  Top = 120
  Width = 1120
  Caption = 'LazRibbon Demo - Workbench CRUD'
  BorderStyle = bsSizeable
  OnCreate = FormCreate
  ClientHeight = 680
  ClientWidth = 1120
  Color = clBtnFace
  Font.Height = -12
  Font.Name = 'Segoe UI'
  ParentFont = False
  LCLVersion = '4.8.0.0'
  Ribbon = LazRibbon1
  SkinManager = LazRibbonSkinManager1
  UseCustomTitleBar = True
  TitleBarHeight = 32
  ShowSystemButtons = True
  ShowTitleIcon = True
  TitleAlignment = taCenter
  object ActionList1: TActionList
    Left = 24
    Top = 184
    object actNewCustomer: TAction
      Caption = 'Novo'
      Hint = 'Criar um novo cliente'
      OnExecute = ActionExecute
    end
    object actEditCustomer: TAction
      Caption = 'Editar'
      Hint = 'Editar o cliente selecionado'
      OnExecute = ActionExecute
    end
    object actSaveCustomer: TAction
      Caption = 'Salvar'
      Hint = 'Salvar o cliente atual'
      OnExecute = ActionExecute
    end
    object actDeleteCustomer: TAction
      Caption = 'Excluir'
      Hint = 'Excluir o cliente selecionado'
      OnExecute = ActionExecute
    end
    object actRefresh: TAction
      Caption = 'Atualizar'
      Hint = 'Atualizar a grade'
      OnExecute = ActionExecute
    end
    object actFind: TAction
      Caption = 'Filtrar'
      Hint = 'Filtrar clientes'
      OnExecute = ActionExecute
    end
    object actClearFilter: TAction
      Caption = 'Limpar'
      Hint = 'Limpar filtro'
      OnExecute = ActionExecute
    end
    object actExport: TAction
      Caption = 'Exportar'
      Hint = 'Exportar registros'
      OnExecute = ActionExecute
    end
    object actPrint: TAction
      Caption = 'Imprimir'
      Hint = 'Imprimir a lista'
      OnExecute = ActionExecute
    end
    object actCloseMonth: TAction
      Caption = 'Fechar mes'
      Hint = 'Executar rotina mensal'
      OnExecute = ActionExecute
    end
    object actOptions: TAction
      Caption = 'Opcoes'
      Hint = 'Abrir opcoes'
      OnExecute = ActionExecute
    end
    object actHelp: TAction
      Caption = 'Ajuda'
      Hint = 'Ajuda do demo'
      OnExecute = ActionExecute
    end
    object actExit: TAction
      Caption = 'Sair'
      Hint = 'Sair do demo'
      OnExecute = ActionExecute
    end
  end
  object LazRibbonSkinManager1: TLazRibbonSkinManager
    ActiveSkinName = 'ModernLight'
    Left = 120
    Top = 184
  end
  object LazRibbon1: TLazRibbon
    Left = 0
    Height = 112
    Top = 0
    Width = 1120
    Align = alTop
    ApplicationButton.Caption = 'Arquivo'
    ApplicationButton.KeyTip = 'A'
    ApplicationButton.Hint = 'Abrir o BackStage do cadastro'
    ApplicationButton.Visible = True
    ApplicationButton.Mode = abmBackstage
    ShowContextualGroupHeaders = True
    ContextualGroupHeaderHeight = 18
    QuickAccessToolBar.Visible = True
    QuickAccessToolBar.Position = qapTitleBar
    QuickAccessToolBar.Items = <
      item
        Action = actNewCustomer
        KeyTip = '1'
        LinkedItem = BtnNewCustomer
      end
      item
        Action = actSaveCustomer
        KeyTip = '2'
        LinkedItem = BtnSaveCustomer
      end
      item
        Action = actRefresh
        KeyTip = '3'
        LinkedItem = BtnRefresh
      end>
    QuickAccessToolBar.CustomizeActionList = ActionList1
    QuickAccessToolBar.CustomizeMenuTitle = 'Personalizar Barra de Acesso Rapido'
    QuickAccessToolBar.MoreCommandsCaption = 'Mais comandos...'
    QuickAccessToolBar.ShowAboveRibbonCaption = 'Mostrar acima da Faixa de Opcoes'
    QuickAccessToolBar.ShowBelowRibbonCaption = 'Mostrar abaixo da Faixa de Opcoes'
    QuickAccessToolBar.MinimizeRibbonCaption = 'Minimizar a Faixa de Opcoes'
    QuickAccessToolBar.RestoreRibbonCaption = 'Restaurar a Faixa de Opcoes'
    QuickAccessToolBar.ResetToDefaultsCaption = 'Restaurar Barra de Acesso Rapido'
    BackstageView = BackstageView
    AppearanceSource = asSkinManager
    SkinManager = LazRibbonSkinManager1
    ShowHint = True
    Tabs = (
      'TabHome'
      'TabData'
      'TabView'
      'TabCustomerTools'
    )
    TabIndex = 0
    object TabHome: TLazRibbonTab
      Caption = 'Inicio'
      KeyTip = 'I'
      Panes = (
        'PaneRecords'
        'PaneSearch'
        'PaneWorkflow'
      )
      object PaneRecords: TLazRibbonPane
        Caption = 'Registros'
        ShowDialogLauncher = True
        OnDialogLauncherClick = PaneDialogLauncherClick
        Items = (
          'BtnNewCustomer'
          'BtnSaveCustomer'
          'BtnEditCustomer'
          'BtnDeleteCustomer'
        )
        object BtnNewCustomer: TLazRibbonLargeButton
          Action = actNewCustomer
          KeyTip = 'N'
          ScreenTipTitle = 'Novo cliente'
          ScreenTipText = 'Limpa o painel de edicao para cadastrar um novo cliente.'
          ScreenTipShortcut = 'Ctrl+N'
        end
        object BtnSaveCustomer: TLazRibbonLargeButton
          Action = actSaveCustomer
          KeyTip = 'S'
          ScreenTipTitle = 'Salvar cliente'
          ScreenTipText = 'Grava o conteudo do painel de edicao na grade.'
          ScreenTipShortcut = 'Ctrl+S'
        end
        object BtnEditCustomer: TLazRibbonSmallButton
          Action = actEditCustomer
          KeyTip = 'E'
          ShowCaption = True
          TableBehaviour = tbBeginsRow
        end
        object BtnDeleteCustomer: TLazRibbonSmallButton
          Action = actDeleteCustomer
          KeyTip = 'D'
          ShowCaption = True
          TableBehaviour = tbBeginsRow
        end
      end
      object PaneSearch: TLazRibbonPane
        Caption = 'Busca'
        Items = (
          'BtnFind'
          'BtnClearFilter'
          'BtnRefresh'
        )
        object BtnFind: TLazRibbonLargeButton
          Action = actFind
          KeyTip = 'F'
          ScreenTipTitle = 'Filtrar'
          ScreenTipText = 'Aplica o filtro informado acima da grade.'
        end
        object BtnClearFilter: TLazRibbonSmallButton
          Action = actClearFilter
          KeyTip = 'L'
          ShowCaption = True
          TableBehaviour = tbBeginsRow
        end
        object BtnRefresh: TLazRibbonSmallButton
          Action = actRefresh
          KeyTip = 'R'
          ShowCaption = True
          TableBehaviour = tbBeginsRow
        end
      end
      object PaneWorkflow: TLazRibbonPane
        Caption = 'Rotina'
        Items = (
          'BtnCloseMonth'
          'BtnOptions'
          'BtnHelp'
        )
        object BtnCloseMonth: TLazRibbonSmallButton
          Action = actCloseMonth
          KeyTip = 'FM'
          ShowCaption = True
        end
        object BtnOptions: TLazRibbonSmallButton
          Action = actOptions
          KeyTip = 'OP'
          ShowCaption = True
          TableBehaviour = tbBeginsRow
        end
        object BtnHelp: TLazRibbonSmallButton
          Action = actHelp
          KeyTip = 'H'
          ShowCaption = True
          TableBehaviour = tbBeginsRow
        end
      end
    end
    object TabData: TLazRibbonTab
      Caption = 'Dados'
      KeyTip = 'D'
      Panes = (
        'PaneOutput'
      )
      object PaneOutput: TLazRibbonPane
        Caption = 'Saida'
        Items = (
          'BtnExport'
          'BtnPrint'
        )
        object BtnExport: TLazRibbonLargeButton
          Action = actExport
          KeyTip = 'EX'
          DropdownMenu = PopupGrid
          ScreenTipTitle = 'Exportar'
          ScreenTipText = 'Mostra um comando com menu de contexto Ribbon associado.'
        end
        object BtnPrint: TLazRibbonLargeButton
          Action = actPrint
          KeyTip = 'PR'
          ScreenTipTitle = 'Imprimir'
          ScreenTipText = 'Executa uma impressao ficticia da lista de clientes.'
        end
      end
    end
    object TabView: TLazRibbonTab
      Caption = 'Exibir'
      KeyTip = 'V'
      Panes = (
        'PaneView'
      )
      object PaneView: TLazRibbonPane
        Caption = 'Aparencia'
        Items = (
          'SkinGallery'
        )
        object SkinGallery: TLazRibbonSkinGalleryItem
          Caption = 'Skins'
          KeyTip = 'K'
          DisplayMode = rimLarge
          Width = 190
          SkinManager = LazRibbonSkinManager1
          Columns = 4
          IconWidth = 22
          IconHeight = 22
          MaxVisibleItems = 8
          ShowHints = True
        end
      end
    end
    object TabCustomerTools: TLazRibbonTab
      Caption = 'Cliente'
      KeyTip = 'C'
      Contextual = True
      ContextualGroupCaption = 'Cliente selecionado'
      ContextualColor = 32768
      Visible = False
      Panes = (
        'PaneCustomer'
      )
      object PaneCustomer: TLazRibbonPane
        Caption = 'Acoes do cliente'
        Items = (
          'BtnCustomerPrint'
          'BtnCustomerEdit'
          'BtnCustomerDelete'
        )
        object BtnCustomerPrint: TLazRibbonLargeButton
          Action = actPrint
          KeyTip = 'IP'
          ScreenTipTitle = 'Imprimir ficha'
          ScreenTipText = 'Exemplo de comando contextual para o cliente selecionado.'
        end
        object BtnCustomerEdit: TLazRibbonSmallButton
          Action = actEditCustomer
          KeyTip = 'ED'
          ShowCaption = True
          TableBehaviour = tbBeginsRow
        end
        object BtnCustomerDelete: TLazRibbonSmallButton
          Action = actDeleteCustomer
          KeyTip = 'XC'
          ShowCaption = True
          TableBehaviour = tbBeginsRow
        end
      end
    end
  end
  object StatusBar1: TStatusBar
    Left = 0
    Height = 22
    Top = 658
    Width = 1120
    Align = alBottom
    SimplePanel = True
    SimpleText = 'Pronto.'
  end
